  "_group_docs": {
    "orientation": "View angles -> sincos (NEVER raw — avoids the false +-180 wrap discontinuity). Includes the v3 turn-direction SELF pair (yaw_rate_z + face_vel_angle_norm, THE air-strafe direction signal: sign(sidemove) == -sign(yaw_rate)) and the v4 route-conditioning goal triple (goal_heading_sincos + goal_dist_norm, the navigation signal open-loop BC lacked; goal=None => free-roam [0,0,1]). All APPENDED (never reordered) so the frozen prefix stays byte-stable.",
    "player_resource": "Own health/armor/weapon/ammo/powerup state.",
    "item": "Per tracked item TYPE (rl, ra, ya, ga, mh, quad, ...): one block instantiated per item (per_item: true). Nearest entity of each type, egocentric polar + respawn timing.",
    "player_style": "Supersedes player_movement_signatures.v1 + bunnyhop_fingerprint.v1: episode/player-level context features (constant within an episode).",
    "entity_observation": "v2: per OTHER actor (opponents + teammates), egocentric. Variable-length list pooled by a DeepSets/small-transformer head with a PAD-MASK (NOT fixed sorted slots): permutation- and side-invariant. N_max=7 (4on4 = 7 others); 1v1 is the SAME path with more masking. Live _est fields are ZEROED when the entity is invisible (mask bit = entity_is_visible); the belief block carries memory. Sources are actor_ticks (omniscient world) gated by actor_visibility.",
    "audio": "v2: per-type spatial audio cue (NOT FOV/LOS-gated — sound bends around corners). Instantiated per src_type {weapon_fire, item_pickup, footstep}. Decayed intensity + direction.",
    "team": "v2: team-aggregate context (4on4). All relative/egocentric. Enemy aggregates are GATED behind 'seen recently' -> zeroed otherwise (no wallhack).",
    "action": "LABELS / targets — NOT observation inputs (leakage_safe: false).",
    "rtg": "Decision-Transformer return-to-go (NOT an observation; future-derived)."
  }
}
