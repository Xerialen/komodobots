{
  "_schema": "komodobots.feature_registry.v1",
  "_doc": "komodobots ML Feature Registry. schema tag: komodobots.feature_registry.v1 (v1 features unchanged; v2 adds groups; v3 APPENDS the turn-direction SELF features yaw_rate_z + face_vel_angle_norm; v4 APPENDS the route-conditioning SELF features goal_heading_sincos + goal_dist_norm; v5 SEQUENCE-AWARE: SELF channels unchanged (still 21, goal-conditioned) but the policy now consumes a FLAT last-16-tick SELF history (self_history field, width 16*21=336) — a shape/contract change, not a new per-tick feature). Single declarative source for every model input: the SAME `transform` string drives offline mining AND the live online encoder -> zero training-serving skew. Each feature traces to a real column in catalog_schema.sql (source) OR a formula over such columns, plus a normalization method + a stats_key into normalization_stats.template.json. leakage_safe: true => uses only state at tick <= t (PIT-safe); false => MUST be excluded from observation features (a label or future-derived quantity). Normalization methods: zscore | minmax | robust | log1p_zscore | sincos | divide_period | identity. group: per_map => stats keyed by map; global => one set; none => parameter-free. CONVENTION: any key beginning with `_` is documentation-only and is ignored by the generator and all consumers. Migrated YAML->JSON in T1.1 (#418); the obs-vector layout is now explicit under `observation` and the generated artifacts derive from this file (see scripts/generate_from_registry.py).",
  "registry_version": 5,
  "entity": {
    "name": "agent",
    "join_keys": [
      "episode_id",
      "tick"
    ]
  },
  "normalization_artifact": "norm/normalization_stats.template.json",
  "catalog": "../../scripts/catalog_schema.sql",
  "defaults": {
    "group": "per_map"
  },
  "constants": {
    "eps": 1e-06,
    "map_diagonal_dm3": 3797.1,
    "_note": "dm3 AABB diagonal (qu) from maps.v1: sqrt(3032^2+2096^2+912^2)."
  },
  "observation": {
    "_doc": "Explicit obs-vector channel layout — previously implicit ONLY in scripts/features/agent_observation.py (SELF_FIELDS/ENTITY_FIELDS/ACT_FIELDS) and duplicated as hard-coded dims in ml/broad_bc/shard_contract.py. This is the SINGLE source scripts/generate_from_registry.py reads to emit registry_constants_generated.py + obs_spec.generated.json. Channels are FLATTENED (a sincos feature contributes <name>_sin + <name>_cos); `onground` is a registered feature (feature_groups.position) carried as one channel. Order is LOAD-BEARING (the obs.npy column order) — append, never reorder.",
    "self_layout": [
      "pos_x_norm",
      "pos_y_norm",
      "pos_z_norm",
      "vel_x_z",
      "vel_y_z",
      "vel_z_z",
      "hspeed_norm",
      "vel_heading_sin",
      "vel_heading_cos",
      "yaw_sin",
      "yaw_cos",
      "pitch_sin",
      "pitch_cos",
      "onground",
      "health_norm",
      "armor_norm",
      "yaw_rate_z",
      "face_vel_angle_norm",
      "goal_heading_sin",
      "goal_heading_cos",
      "goal_dist_norm"
    ],
    "entity_layout": [
      "entity_rel_dist_norm",
      "entity_rel_bearing_sin",
      "entity_rel_bearing_cos",
      "entity_rel_pitch_sin",
      "entity_rel_pitch_cos",
      "entity_rel_vel_x",
      "entity_rel_vel_y",
      "entity_rel_vel_z",
      "entity_health_est_norm",
      "entity_armor_est_norm",
      "entity_alive",
      "entity_is_teammate",
      "entity_is_visible"
    ],
    "action_layout": [
      "forwardmove",
      "sidemove",
      "upmove",
      "jump_button",
      "attack_button"
    ],
    "self_history": 16,
    "n_max": 7,
    "required_norm_keys": [
      "yaw_rate"
    ]
  },
  "feature_groups": {
    "position": [
      {
        "name": "pos_x_norm",
        "dtype": "float32",
        "source": "player_ticks.ox",
        "formula": "(ox - x_min) / (x_max - x_min)",
        "unit": "[0,1]",
        "norm": "minmax",
        "stats_key": "per_map.<map>.pos_x",
        "group": "per_map",
        "version": 1,
        "leakage_safe": true,
        "note": "Absolute position; auxiliary only. Egocentric features generalize across maps better."
      },
      {
        "name": "pos_y_norm",
        "dtype": "float32",
        "source": "player_ticks.oy",
        "formula": "(oy - y_min) / (y_max - y_min)",
        "unit": "[0,1]",
        "norm": "minmax",
        "stats_key": "per_map.<map>.pos_y",
        "group": "per_map",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "pos_z_norm",
        "dtype": "float32",
        "source": "player_ticks.oz",
        "formula": "(oz - z_min) / (z_max - z_min)",
        "unit": "[0,1]",
        "norm": "minmax",
        "stats_key": "per_map.<map>.pos_z",
        "group": "per_map",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "nearest_marker_dist_norm",
        "dtype": "float32",
        "source": "derived",
        "formula": "min_dist(origin, markers.origin) / map_diagonal",
        "unit": "[0,1]",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true,
        "note": "Distance to nearest nav-graph marker (markers table). Already in [0,1] after /diagonal."
      },
      {
        "name": "over_void",
        "dtype": "float32",
        "source": "derived",
        "formula": "1.0 if no floor below origin else 0.0",
        "unit": "0/1",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "height_above_floor_norm",
        "dtype": "float32",
        "source": "derived",
        "formula": "robust(oz - floor_z)",
        "unit": "qu",
        "norm": "robust",
        "stats_key": "per_map.<map>.height_above_floor",
        "group": "per_map",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "onground",
        "dtype": "float32",
        "source": "player_ticks.onground",
        "formula": "1.0 if standing on ground else 0.0",
        "unit": "0/1",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true,
        "note": "Ground-contact state; part of the frozen-16 SELF vector (observation.self_layout, channel index 13). Geometric onground proxy from player_ticks.onground (pmove_sim; MVD has no server flag). Was consumed by the live encoder (agent_observation.SELF_FIELDS) but UNREGISTERED before T1.1 — exactly the silent drift this ticket closes."
      }
    ],
    "velocity": [
      {
        "name": "vel_x_z",
        "dtype": "float32",
        "source": "player_ticks.vx",
        "formula": "(vx - mean) / std",
        "unit": "qu/s",
        "norm": "zscore",
        "stats_key": "per_map.<map>.vel_x",
        "group": "per_map",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "vel_y_z",
        "dtype": "float32",
        "source": "player_ticks.vy",
        "formula": "(vy - mean) / std",
        "unit": "qu/s",
        "norm": "zscore",
        "stats_key": "per_map.<map>.vel_y",
        "group": "per_map",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "vel_z_z",
        "dtype": "float32",
        "source": "player_ticks.vz",
        "formula": "(vz - mean) / std",
        "unit": "qu/s",
        "norm": "zscore",
        "stats_key": "per_map.<map>.vel_z",
        "group": "per_map",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "hspeed_norm",
        "dtype": "float32",
        "source": "player_ticks.hspeed",
        "formula": "robust(hypot(vx,vy))",
        "unit": "qu/s",
        "norm": "robust",
        "stats_key": "per_map.<map>.hspeed",
        "group": "per_map",
        "version": 1,
        "leakage_safe": true,
        "note": "Supersedes movement_metrics.v2 avg/p50/p95 speed scalars as a per-tick feature."
      },
      {
        "name": "vel_heading_sincos",
        "dtype": "float32[2]",
        "source": "derived",
        "formula": "[sin(atan2(vy,vx)), cos(atan2(vy,vx))]",
        "unit": "[-1,1]x2",
        "norm": "sincos",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      }
    ],
    "orientation": [
      {
        "name": "yaw_sincos",
        "dtype": "float32[2]",
        "source": "player_ticks.yaw",
        "formula": "[sin(rad(yaw)), cos(rad(yaw))]",
        "unit": "[-1,1]x2",
        "norm": "sincos",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "pitch_sincos",
        "dtype": "float32[2]",
        "source": "player_ticks.pitch",
        "formula": "[sin(rad(pitch)), cos(rad(pitch))]",
        "unit": "[-1,1]x2",
        "norm": "sincos",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "look_vs_move_sincos",
        "dtype": "float32[2]",
        "source": "derived",
        "formula": "lvm=wrap180(yaw - vel_heading_deg); [sin(rad(lvm)),cos(rad(lvm))]",
        "unit": "[-1,1]x2",
        "norm": "sincos",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true,
        "note": "Strafe-jump signature axis (look-vs-move angle). Key for player-style/bunnyhop imitation."
      },
      {
        "name": "yaw_rate_z",
        "dtype": "float32",
        "source": "derived",
        "formula": "wrap180(yaw[t] - yaw[t-1]) / dt_s  (deg/s); zscore",
        "unit": "deg/s",
        "norm": "zscore",
        "stats_key": "per_map.<map>.yaw_rate",
        "group": "per_map",
        "version": 3,
        "leakage_safe": true,
        "note": "THE air-strafe direction signal. sign(sidemove) == -sign(yaw_rate) (88-94%, the QW air-accel rule). First tick of an episode/rollout => 0.0. Computed by the SHARED agent_observation.yaw_rate_degps in BOTH the offline build and every inference call-site (train/serve parity)."
      },
      {
        "name": "face_vel_angle_norm",
        "dtype": "float32",
        "source": "derived",
        "formula": "wrap180(yaw - vel_heading_deg) / 180.0",
        "unit": "[-1,1]",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 3,
        "leakage_safe": true,
        "note": "Signed look-vs-move angle as a single scalar (SIGN survives; near-0 sign matters for strafe). 0 below the 80 qu/s velocity-heading floor (heading undefined), same guard as vel_heading. Scalar complement to look_vs_move_sincos."
      },
      {
        "name": "goal_heading_sincos",
        "dtype": "float32[2]",
        "source": "derived",
        "formula": "[sin(atan2(goal_y-oy, goal_x-ox)), cos(atan2(goal_y-oy, goal_x-ox))]",
        "unit": "[-1,1]x2",
        "norm": "sincos",
        "stats_key": null,
        "group": "none",
        "version": 4,
        "leakage_safe": true,
        "note": "Egocentric heading to the next-resource GOAL on the current route. goal=None (no goal assigned) => [0,0] (free-roam). THE navigation signal open-loop BC lacked: tells the policy where it is headed so it stops memorising one trajectory per route."
      },
      {
        "name": "goal_dist_norm",
        "dtype": "float32",
        "source": "derived",
        "formula": "min(dist(origin, goal) / map_diagonal_dm3, 1.0)",
        "unit": "[0,1]",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 4,
        "leakage_safe": true,
        "note": "Normalized distance to the next-resource goal. 1.0 when no goal is assigned (free-roam); heading is then [0,0]. Parameter-free (/diagonal), no fitted key."
      }
    ],
    "player_resource": [
      {
        "name": "health_norm",
        "dtype": "float32",
        "source": "player_ticks.health",
        "formula": "clip(health,0,250)/250.0",
        "unit": "[0,1]",
        "norm": "divide_period",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "armor_norm",
        "dtype": "float32",
        "source": "player_ticks.armor",
        "formula": "clip(armor,0,200)/200.0",
        "unit": "[0,1]",
        "norm": "divide_period",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "armor_type_onehot",
        "dtype": "float32[3]",
        "source": "player_ticks.armor_type",
        "formula": "onehot(armor_type, [GA,YA,RA])",
        "unit": "onehot",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "weapon_onehot",
        "dtype": "float32[8]",
        "source": "player_ticks.weapon",
        "formula": "onehot(weapon, [axe,sg,ssg,ng,sng,gl,rl,lg])",
        "unit": "onehot",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 2,
        "leakage_safe": true
      },
      {
        "name": "ammo_per_weapon_norm",
        "dtype": "float32[4]",
        "source": "derived",
        "formula": "[sh/SH, nl/NL, rk/RK, cl/CL]",
        "unit": "[0,1]x4",
        "norm": "divide_period",
        "stats_key": null,
        "group": "none",
        "version": 2,
        "leakage_safe": true,
        "note": "Self ammo per weapon-class. Periods sh/nl/rk/cl in normalization divide_period."
      },
      {
        "name": "powerup_remaining",
        "dtype": "float32[3]",
        "source": "derived",
        "formula": "[quad_rem/60, pent_rem/300, ring_rem/60]",
        "unit": "[0,1]x3",
        "norm": "divide_period",
        "stats_key": null,
        "group": "none",
        "version": 2,
        "leakage_safe": true,
        "note": "Self powerup remaining; reuses quad/pent/ring_remaining divide_period periods."
      }
    ],
    "item": [
      {
        "name": "item_dist_norm",
        "dtype": "float32",
        "per_item": true,
        "source": "derived",
        "formula": "dist(origin, item.origin) / map_diagonal",
        "unit": "[0,1]",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "item_bearing_sincos",
        "dtype": "float32[2]",
        "per_item": true,
        "source": "derived",
        "formula": "ego=rotate(item.origin-origin, -yaw); [sin(atan2(ego.y,ego.x)), cos(atan2(ego.y,ego.x))]",
        "unit": "[-1,1]x2",
        "norm": "sincos",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true,
        "note": "Egocentric bearing to item, rotated into agent facing frame (translation+rotation invariant)."
      },
      {
        "name": "item_remaining_norm",
        "dtype": "float32",
        "per_item": true,
        "source": "item_events + items.respawn_seconds",
        "formula": "clip(respawn_at - t_now, 0, T) / T",
        "unit": "[0,1]; 0=up now",
        "norm": "divide_period",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true,
        "note": "respawn_at derived from last pickup item_event (t_pickup + T). PIT-safe: uses events t<=now only."
      },
      {
        "name": "item_available_now",
        "dtype": "float32",
        "per_item": true,
        "source": "item_events + items.respawn_seconds",
        "formula": "1.0 if (respawn_at - t_now) <= 0 else 0.0",
        "unit": "0/1",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "item_unknown_flag",
        "dtype": "float32",
        "per_item": true,
        "source": "derived",
        "formula": "1.0 if respawn_at is unobserved else 0.0",
        "unit": "0/1",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true,
        "note": "Third state for unobserved timers (do NOT emit a sentinel number into remaining_norm)."
      },
      {
        "name": "item_eta_norm",
        "dtype": "float32",
        "per_item": true,
        "source": "derived",
        "formula": "min(dist_to_item / max(hspeed, eps), CAP) / CAP",
        "unit": "[0,1]",
        "norm": "divide_period",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "item_up_on_arrival",
        "dtype": "float32",
        "per_item": true,
        "source": "derived",
        "formula": "1.0 if (dist_to_item/max(hspeed,eps)) >= (respawn_at - t_now) else 0.0",
        "unit": "0/1",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true,
        "note": "The core item-contest decision feature (will_be_up_on_arrival)."
      },
      {
        "name": "item_value_prior",
        "dtype": "float32",
        "per_item": true,
        "source": "items.static_value",
        "formula": "items.static_value",
        "unit": "[0,1]",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true,
        "note": "Static importance prior; replaced by data-derived item_value.importance_norm once fitted (train-only)."
      }
    ],
    "timing": [
      {
        "name": "match_progress",
        "dtype": "float32",
        "source": "player_ticks.t_s / demos.duration_s",
        "formula": "t_elapsed / match_duration",
        "unit": "[0,1]",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "time_since_pickup_log",
        "dtype": "float32",
        "source": "item_events",
        "formula": "log1p(t_now - t_last_pickup)",
        "unit": "log-s",
        "norm": "log1p_zscore",
        "stats_key": "global.time_since_pickup",
        "group": "global",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "spawn_phase_sincos",
        "dtype": "float32[2]",
        "per_item": true,
        "source": "derived",
        "formula": "[sin(2*pi*(t_now mod T)/T), cos(2*pi*(t_now mod T)/T)]",
        "unit": "[-1,1]x2",
        "norm": "sincos",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "time_to_reach_navgraph_norm",
        "dtype": "float32",
        "source": "derived",
        "formula": "min(navgraph_path_len(cur_marker, goal_marker)/max(hspeed,eps), CAP)/CAP",
        "unit": "[0,1]",
        "norm": "divide_period",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true,
        "note": "ETA along nav_edges (graph distance, not straight-line). CAP=10s."
      }
    ],
    "player_style": [
      {
        "name": "jump_cadence_norm",
        "dtype": "float32",
        "source": "derived",
        "formula": "robust(jumps_per_active_min)",
        "unit": "jumps/min",
        "norm": "robust",
        "stats_key": "global.jump_cadence",
        "group": "global",
        "version": 1,
        "leakage_safe": true,
        "note": "Strongest repeated player-style axis (Milton 44.9, carapace 44.0, yeti 48.6)."
      },
      {
        "name": "stationary_time_ratio",
        "dtype": "float32",
        "source": "derived",
        "formula": "frac(hspeed < 10)",
        "unit": "[0,1]",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true
      },
      {
        "name": "player_id_embed",
        "dtype": "int32",
        "source": "episodes.player_id",
        "formula": "player_id (embedding lookup in model)",
        "unit": "id",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 1,
        "leakage_safe": true,
        "note": "Categorical; held-out player_ids reserved for style-generalization test split."
      },
      {
        "name": "player_role_soft",
        "dtype": "float32[2]",
        "source": "derived",
        "formula": "soft_role(episode movement/item stats) -> [runner, anchor]",
        "unit": "[0,1]x2",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 2,
        "leakage_safe": true,
        "note": "Soft (not hard) role vector runner/anchor; episode-level, derived from movement + item-control stats. 4on4 team-role groundwork (00-DATA-ARCHITECTURE §3.7)."
      }
    ],
    "entity_observation": [
      {
        "name": "entity_rel_dist_norm",
        "dtype": "float32",
        "source": "derived",
        "formula": "dist(actor_ticks.origin, ego.origin) / map_diagonal",
        "unit": "[0,1]",
        "norm": "identity",
        "stats_key": null,
        "group": "none",
        "version": 2,
        "leakage_safe": true,
        "note": "Egocentric distance to the other actor; identity after /diagonal (like item_dist_norm)."
      },
      {
        "name": "entity_rel_bearing_sincos",
        "dtype": "float32[2]",
        "source": "derived",
        "formula": "ego=rotate(actor_ticks.origin-ego.origin, -yaw); [sin(atan2(ego.y,ego.x)),cos(atan2(ego.y,ego.x))]",
        "unit": "[-1,1]x2",
        "norm": "sincos",
        "stats_key": null,
        "group": "none",
        "version": 2,
        "leakage_safe": true
      },
      {
        "name": "entity_rel_pitch_sincos",
        "dtype": "float32[2]",
        "source": "derived",
        "formula": "[sin(elev_to(actor_ticks.origin)), cos(elev_to(actor_ticks.origin))]",
        "unit": "[-1,1]x2",
