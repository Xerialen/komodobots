 #ifndef Q3_VM
+#include <time.h>
+
+// --- on-KTX cost instrumentation (T0.3 PR-C): time the live-loop work (build
+// world-view + write VIEW + read MOVE + apply) per tick and emit a periodic
+// p50/p99/max summary vs the T0.2 0.5 ms (500 us) budget. Native-only; a coarse
+// fixed-bucket histogram (no qsort, no alloc), gated by k_fb_moveprobe_live_log.
+#define MOVEPROBE_P99_BUCKETS 256
+#define MOVEPROBE_P99_US_PER_BUCKET 5		/* 0..1280 us window, 5 us resolution */
+static unsigned	moveprobe_p99_hist[MOVEPROBE_P99_BUCKETS];
+static unsigned	moveprobe_p99_count = 0;
+static double	moveprobe_p99_max = 0.0;
+static float	moveprobe_p99_last_report = 0.0f;
+
+static double moveprobe_now_us(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (double) ts.tv_sec * 1e6 + (double) ts.tv_nsec * 1e-3;
+}
+
+static void moveprobe_p99_record(double us)
+{
+	int b = (int) (us / MOVEPROBE_P99_US_PER_BUCKET);
+	if (b < 0)
+	{
+		b = 0;
+	}
+	if (b >= MOVEPROBE_P99_BUCKETS)
+	{
+		b = MOVEPROBE_P99_BUCKETS - 1;
+	}
+	moveprobe_p99_hist[b]++;
+	moveprobe_p99_count++;
+	if (us > moveprobe_p99_max)
+	{
+		moveprobe_p99_max = us;
+	}
+}
+
+// Upper-edge (us) of the bucket holding the target-th smallest sample.
+static double moveprobe_p99_pct(unsigned target)
+{
+	unsigned cum = 0;
+	int b;
+	for (b = 0; b < MOVEPROBE_P99_BUCKETS; b++)
+	{
+		cum += moveprobe_p99_hist[b];
+		if (cum >= target)
+		{
+			return (double) (b + 1) * MOVEPROBE_P99_US_PER_BUCKET;
+		}
+	}
+	return (double) MOVEPROBE_P99_BUCKETS * MOVEPROBE_P99_US_PER_BUCKET;
+}
+
+// Emit a p50/p99/max summary at most once per ~10 s while live logging is on.
+static void moveprobe_p99_maybe_report(void)
+{
+	float now = g_globalvars.time;
+	int b;
+
+	if (!cvar("k_fb_moveprobe_live_log"))
+	{
+		return;
+	}
+	if (moveprobe_p99_last_report == 0.0f)
+	{
+		moveprobe_p99_last_report = now;
+	}
+	if ((moveprobe_p99_count < 256) || ((now - moveprobe_p99_last_report) < 10.0f))
+	{
+		return;
+	}
+	G_bprint(PRINT_HIGH,
+			 "[moveprobe-live] on-KTX cost over %u ticks: p50<=%.0f us p99<=%.0f us max=%.1f us (budget 500 us)\n",
+			 moveprobe_p99_count, moveprobe_p99_pct(moveprobe_p99_count / 2),
+			 moveprobe_p99_pct((moveprobe_p99_count * 99) / 100), moveprobe_p99_max);
+	for (b = 0; b < MOVEPROBE_P99_BUCKETS; b++)
+	{
+		moveprobe_p99_hist[b] = 0;
+	}
+	moveprobe_p99_count = 0;
+	moveprobe_p99_max = 0.0;
+	moveprobe_p99_last_report = now;
+}
+
