 	buttons |= (firing ? 1 : 0);
 	buttons |= (jumping ? 2 : 0);
+	BotLogMoveProbeCommand(self, cmd_msec, direction, buttons, impulse);
 	trap_SetBotCMD(NUM_FOR_EDICT(self), cmd_msec, PASSVEC3(self->fb.desired_angle),
 					PASSVEC3(direction), buttons, impulse);
 
