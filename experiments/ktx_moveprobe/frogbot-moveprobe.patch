+static int BotMoveProbeParseReplayLine(char *line, moveprobe_replay_frame_t *f)
+{
+	float vals[14];
+	char *cursor = line;
+	int i;
+
+	for (i = 0; i < 14; i++)
+	{
+		while ((*cursor == ' ') || (*cursor == '\t'))
+		{
+			cursor++;
+		}
+		if ((*cursor == '\0') || (*cursor == '\n') || (*cursor == '\r'))
+		{
+			return 0;
+		}
+		vals[i] = atof(cursor);
+		while (*cursor && (*cursor != ' ') && (*cursor != '\t')
+			&& (*cursor != '\n') && (*cursor != '\r'))
+		{
+			cursor++;
+		}
+	}
+
+	f->msec = (int)vals[0];
+	f->origin[0] = vals[1];
+	f->origin[1] = vals[2];
+	f->origin[2] = vals[3];
+	f->velocity[0] = vals[4];
+	f->velocity[1] = vals[5];
+	f->velocity[2] = vals[6];
+	f->angles[0] = vals[7];
+	f->angles[1] = vals[8];
+	f->angles[2] = vals[9];
+	f->forwardmove = (int)vals[10];
+	f->sidemove = (int)vals[11];
+	f->upmove = (int)vals[12];
+	f->buttons = (int)vals[13];
+	return 1;
+}
+
+static int BotMoveProbeLoadReplayFile(const char *fname)
+{
+	fileHandle_t handle;
+	char line[256];
+	int count = 0;
+	float cumulative = 0.0f;
+
+	handle = std_fropen("%s", fname);
+	if (handle < 0)
+	{
+		return -1;
+	}
+
+	while ((count < MOVEPROBE_REPLAY_MAX_FRAMES) && std_fgets(handle, line, sizeof(line)))
+	{
+		moveprobe_replay_frame_t *f;
+
+		if ((line[0] == '#') || (line[0] == '\0') || (line[0] == '\n') || (line[0] == '\r'))
+		{
+			continue;
+		}
+
+		f = &moveprobe_replay_frames[count];
+		if (!BotMoveProbeParseReplayLine(line, f))
+		{
+			continue;
+		}
+		if (f->msec < 1)
+		{
+			f->msec = 1;
+		}
+		cumulative += (float)f->msec;
+		f->cumulative_ms = cumulative;
+		count++;
+	}
+
+	std_fclose(handle);
+	return count;
+}
+
+static int BotMoveProbeEnsureReplayLoaded(void)
+{
+	char fname[128];
+
+	trap_cvar_string("k_fb_moveprobe_replay_file", fname, sizeof(fname));
+	if (fname[0] == '\0')
+	{
+		moveprobe_replay_load_state = 0;
+		moveprobe_replay_count = 0;
+		moveprobe_replay_loaded_file[0] = '\0';
+		return 0;
+	}
+
+	if ((moveprobe_replay_load_state != 0) && streq(fname, moveprobe_replay_loaded_file))
+	{
+		return (moveprobe_replay_load_state == 1) ? moveprobe_replay_count : 0;
+	}
+
+	strlcpy(moveprobe_replay_loaded_file, fname, sizeof(moveprobe_replay_loaded_file));
+	moveprobe_replay_count = BotMoveProbeLoadReplayFile(fname);
+	if (moveprobe_replay_count < 2)
+	{
+		moveprobe_replay_load_state = -1;
+		moveprobe_replay_count = 0;
+		G_cprint("FBMOVEPROBE_REPLAY load_failed file=%s\n", fname);
+		return 0;
+	}
+
+	moveprobe_replay_load_state = 1;
+	G_cprint("FBMOVEPROBE_REPLAY loaded file=%s frames=%d\n", fname, moveprobe_replay_count);
+	return moveprobe_replay_count;
+}
