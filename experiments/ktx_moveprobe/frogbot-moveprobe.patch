+static int BotMoveProbeReadQwdWaypoints(vec3_t points[MOVEPROBE_QWD_MAX_POINTS])
+{
+	char buffer[2048];
+	char *cursor;
+	int count = 0;
+
+	trap_cvar_string("k_fb_moveprobe_qwd_waypoints", buffer, sizeof(buffer));
+	cursor = buffer;
+	while (*cursor && count < MOVEPROBE_QWD_MAX_POINTS)
+	{
+		char *next;
+
+		points[count][0] = atof(cursor);
+		next = strchr(cursor, ',');
+		if (!next)
+		{
+			break;
+		}
+		cursor = next + 1;
+
+		points[count][1] = atof(cursor);
+		next = strchr(cursor, ',');
+		if (!next)
+		{
+			break;
+		}
+		cursor = next + 1;
+
+		points[count][2] = atof(cursor);
+		count++;
+
+		next = strchr(cursor, ';');
+		if (!next)
+		{
+			break;
+		}
+		cursor = next + 1;
+	}
+
+	return count;
+}
