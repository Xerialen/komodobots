# Stored patch artifacts need LF line endings for `git apply`, while their
# inner diff context can legitimately contain whitespace that ordinary source
# files should not.
.gitattributes text eol=lf
*.patch text eol=lf whitespace=-blank-at-eol,-blank-at-eof,-space-before-tab

# Shell scripts must stay LF on EVERY checkout: this repo is also operated and
# reviewed on Windows (core.autocrlf=true), where a CRLF-converted script breaks
# bash at the first backslash line-continuation ("syntax error near '||'" — the
# post-merge P1 on PR #462, .claude/skills/demo-eyecheck/scripts/eyecheck.sh).
*.sh text eol=lf

# Dashboard data assets absorbed byte-for-byte from local-hub (LD-A1, #84):
# keep them byte-identical on every checkout — deploys serve them verbatim.
lab/dashboard/public/* -text

# Routes manifests (LD-C1, #90): generated with explicit LF by
# lab/tools/build_routes_manifest.py; keep them byte-identical on every
# checkout so a rebuild diffs clean on any platform.
lab/dashboard/public/data/** -text

# Map meshes + maps.json are generated with explicit LF by
# lab/tools/bsp_to_obj.py (LD-C2, #91); keep them byte-identical on every
# checkout so a rebuild diffs clean on any platform.
lab/dashboard/public/maps/** -text
